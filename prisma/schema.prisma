generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SubscriptionClick {
  id          String   @id @default(cuid())
  shop        String
  eventType   String   @default("subscription")
  orderId     String?
  orderNumber String?
  ctaText     String?
  ctaLink     String?
  itemId      String?
  itemTitle   String?
  itemUrl     String?
  source      String?
  payload     String?
  createdAt   DateTime @default(now())

  @@index([shop, eventType, createdAt])
  @@index([shop, createdAt])
  @@index([orderId])
}

model ThankYouBlock {
  id        String   @id @default(cuid())
  shop      String
  type      String
  name      String
  status    String   @default("draft")
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, type, status])
  @@index([shop, updatedAt])
}

model EarningsLog {
  id                 String   @id @default(cuid())
  shop               String
  orderId            String
  orderNumber        String?
  customerId         String?
  customerEmail      String?
  featureType        String   // ONE_CLICK_UPSELL | CHECKOUT_UPSELL | DISCOUNT_CODE | SUBSCRIPTION | GIFT_WRAP | REFERRAL
  itemTitle          String
  variantId          String?
  quantity           Int      @default(1)
  amount             Float    @default(0.0)
  currency           String   @default("USD")
  shippingFeeSaved   Float    @default(0.0)
  discountCode       String?
  isRepeatPurchase   Boolean  @default(false)
  firstOrderId       String?
  returnIntervalDays Int?
  status             String   @default("PAID")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shop, featureType, createdAt])
  @@index([shop, customerId])
  @@index([orderId])
  @@index([discountCode])
}


model HowDidYouHearResponse {
  id             String   @id @default(cuid())
  shop           String
  orderId        String?
  orderNumber    String?
  selectedOption String
  heading        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shop, createdAt])
  @@index([shop, selectedOption])
  @@index([orderId])
}

model CustomerSurveyResponse {
  id          String   @id @default(cuid())
  shop        String
  blockId     String?
  orderId     String?
  orderNumber String?
  answers     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop, createdAt])
  @@index([shop, blockId])
  @@index([orderId])
}
