generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SubscriptionClick {
  id          String   @id @default(cuid())
  shop        String
  eventType   String   @default("subscription")
  orderId     String?
  orderNumber String?
  ctaText     String?  @db.Text
  ctaLink     String?  @db.Text
  itemId      String?
  itemTitle   String?  @db.Text
  itemUrl     String?  @db.Text
  source      String?
  payload     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([shop, eventType, createdAt])
  @@index([shop, createdAt])
  @@index([orderId])
}

model ThankYouBlock {
  id        String   @id @default(cuid())
  shop      String
  type      String
  name      String
  status    String   @default("draft")
  config    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, type, status])
  @@index([shop, updatedAt])
}

model UpsellConversion {
  id                 String   @id @default(cuid())
  shop               String
  orderId            String
  orderNumber        String?
  customerId         String?
  customerEmail      String?
  featureType        String   // ONE_CLICK_UPSELL | DISCOUNT_CODE | SUBSCRIPTION | GIFT_WRAP | REFERRAL
  itemTitle          String   @db.Text
  variantId          String?
  quantity           Int      @default(1)
  amount             Float    @default(0.0)
  currency           String   @default("USD")
  shippingFeeSaved   Float    @default(0.0)
  discountCode       String?
  isRepeatPurchase   Boolean  @default(false)
  firstOrderId       String?
  returnIntervalDays Int?
  status             String   @default("COMPLETED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shop, featureType, createdAt])
  @@index([shop, customerId])
  @@index([orderId])
  @@index([discountCode])
}

model CustomerRetentionLog {
  id                   String    @id @default(cuid())
  shop                 String
  customerId           String
  customerEmail        String?
  initialOrderId       String
  initialOrderDate     DateTime  @default(now())
  lastPurchaseDate     DateTime  @default(now())
  totalOrdersCount     Int       @default(1)
  totalLifetimeValue   Float     @default(0.0)
  discountCodeIssued   String?
  discountCodeRedeemed Boolean   @default(false)
  redeemedOrderId      String?
  subscriptionStatus   String    @default("NONE") // NONE | ACTIVE | PAUSED | CANCELLED
  churnedAt            DateTime?
  churnReason          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([shop, customerId])
  @@index([shop, subscriptionStatus])
  @@index([shop, discountCodeIssued])
}

model DailyRevenueAggregate {
  id                      String   @id @default(cuid())
  shop                    String
  date                    DateTime
  totalRevenue            Float    @default(0.0)
  oneClickUpsellRevenue   Float    @default(0.0)
  discountRevenue         Float    @default(0.0)
  subscriptionRevenue     Float    @default(0.0)
  giftWrapRevenue         Float    @default(0.0)
  shippingFeeSaved        Float    @default(0.0)
  repeatOrdersCount       Int      @default(0)
  newSubscribersCount     Int      @default(0)
  churnedSubscribersCount Int      @default(0)
  activeSubscribersCount  Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([shop, date])
  @@index([shop, date])
}

model HowDidYouHearResponse {
  id             String   @id @default(cuid())
  shop           String
  orderId        String?
  orderNumber    String?
  selectedOption String
  heading        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shop, createdAt])
  @@index([shop, selectedOption])
  @@index([orderId])
}
